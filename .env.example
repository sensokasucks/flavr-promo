# FlaVR Promo settings. In Portainer paste these under the stack's "Environment variables"
# (Advanced mode takes this whole file). For a plain `docker compose up`, copy to .env.
# Keep in sync with flavrpromo/config.py.

# ── Discord (required) ──
# Bot token of FlaVR Promo's OWN Discord application (not FlaVR Bot's; two programs can't share one):
# discord.com/developers/applications → New Application → Bot → Reset Token. docs/PORTAINER.md step 1.
DISCORD_TOKEN=
# Your own Discord user id (Settings → Advanced → Developer Mode, then right-click your name → Copy User ID)
OWNER_ID=
# Your server's id (right-click the server icon → Copy Server ID): commands show up at once
GUILD_ID=

# ── This bot's pages on your home network ──
# Port of the calendar pages, OBS source and .ics feed (FlaVR Bot uses 3870 on the same PC)
LISTEN_PORT=3871
# Address of these pages, used in links it DMs you (the X Article page).
# Leave empty and it finds its own: http://<this PC's home network address>:LISTEN_PORT
WEB_ADDRESS=

# ── Go-live watcher (each platform optional; leave empty to skip it) ──
# The same keys FlaVR Bot used work here (copy them over).
# dev.twitch.tv → Your Console → Register Your Application (OAuth Redirect http://localhost, Confidential)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# console.cloud.google.com → APIs & Services → enable "YouTube Data API v3" → Credentials → API key
# Free: 10,000 quota units a day. The watcher uses about 1 unit per check, plus 1 unit per YouTube
# channel every 6 hours (its 50 newest videos: finds waiting rooms made weeks ahead). The optional deep
# check (/setup youtube-check: off by default, daily / 48h / weekly) adds 100 units per channel a run.
YOUTUBE_API_KEY=
# kick.com → Settings → Developer → Create app
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ── Your DMs (friends live, calendar changes, share text) ──
TZ=America/New_York
# hours (0-23) when DMs wait and arrive together; "off" for none. Never while you're live.
QUIET_HOURS=3-11

# ── Hosts' AI lines (optional) ──
# KoboldCpp on any PC at home: the review picker page (/hosts/pick) then also shows lines it writes
# in Colette's and Clark's voices (their character cards). Empty = template lines only.
# Start KoboldCpp with a model loaded, e.g. http://192.168.1.50:5001
# (Or leave these empty and set it on the settings page, http://<this PC>:3871/settings, which wins.)
KOBOLD_URL=
# Only when KoboldCpp was started with --password
KOBOLD_KEY=

# ── Weekly calendar ──
# Sunday hour (0-23, TZ) the new week's calendar is posted. The reviews (Friday: Monday to Thursday,
# Monday: Friday to Sunday, 10 AM by default) are timed in Discord with /setup review-times.
CALENDAR_PREVIEW_HOUR=10
# Leave empty: the Docker image brings its own Chromium for the calendar picture
CHROMIUM_PATH=

# ── Community calendar (flavrpromo/promo.py) ──
# Members with a role picked in /community roles add their own self-promo posts (message menu
# "Add to community calendar" or /community schedule). How many one person can add in 7 days
# (moderators have no limit), and how many hours a Twitch / Kick channel link added while they're
# offline, with no time given, waits for them to go live before it's dropped.
PROMO_WEEKLY_LIMIT=7
PROMO_WAIT_HOURS=6

# ── Moving over from FlaVR Bot (one time, optional) ──
# The folder on THIS PC that holds FlaVR Bot's flavr_bot.db. On its first start FlaVR Promo copies
# the calendar data from it (people, past streams, schedules, groups, channels picked in Discord).
# Portainer: Volumes → the one ending in "flavr-bot-data" shows its mount point. Usually:
#   /var/lib/docker/volumes/flavr-bot_flavr-bot-data/_data
# Leave empty for a fresh start (anyone who never ran FlaVR Bot).
IMPORT_DIR=
